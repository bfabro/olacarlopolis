rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isNewImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }

    function isNewPdf() {
      return request.resource != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 15 * 1024 * 1024;
    }

    function isNewImageOrPdf() {
      return isNewImage() || isNewPdf();
    }

    function isStudioMasterOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == 'bruno.4and@gmail.com';
    }

    function isStudioSource() {
      return request.resource != null
        && ((request.resource.size < 250 * 1024 * 1024
            && request.resource.contentType.matches('video/(mp4|quicktime|webm)'))
          || (request.resource.size < 20 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)')));
    }

    function isStudioAudio() {
      return request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|mp4|wav|ogg|x-wav)');
    }

    // Olá Studio: originais privados, separados pelo UID do proprietário.
    match /studio/{userId}/originals/{projectId}/{fileName} {
      allow read: if isStudioMasterOwner(userId);
      allow create: if isStudioMasterOwner(userId) && isStudioSource();
      allow update: if false;
      allow delete: if isStudioMasterOwner(userId);
    }

    match /studio/{userId}/logos/{projectId}/{fileName} {
      allow read: if isStudioMasterOwner(userId);
      allow create: if isStudioMasterOwner(userId) && isNewImage();
      allow update: if false;
      allow delete: if isStudioMasterOwner(userId);
    }

    match /studio/{userId}/music/{projectId}/{fileName} {
      allow read: if isStudioMasterOwner(userId);
      allow create: if isStudioMasterOwner(userId) && isStudioAudio();
      allow update: if false;
      allow delete: if isStudioMasterOwner(userId);
    }

    // Planos e renders são gravados somente pelo worker com Firebase Admin.
    match /studio/{userId}/plans/{allPaths=**} {
      allow read: if isStudioMasterOwner(userId);
      allow write: if false;
    }

    match /studio/{userId}/renders/{allPaths=**} {
      allow read: if isStudioMasterOwner(userId);
      allow write: if false;
    }

    // Comprovantes financeiros: nunca publicos.
    // Nesta primeira etapa, qualquer usuario autenticado pode ler e gravar.
    // O isolamento por cliente exigira custom claims ou perfis no Firestore.
    match /clientes/{clientId}/faturas/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isNewImageOrPdf();
      allow delete: if signedIn();
    }

    // Arquivos usados no site publico.
    match /clientes/{clientId}/perfil/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /clientes/{clientId}/imagens/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /clientes/{clientId}/promocoes/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /clientes/{clientId}/servicos/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /clientes/{clientId}/cardapio/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImageOrPdf();
      allow delete: if signedIn();
    }

    match /clientes/{clientId}/grupo-whatsapp/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    // Bloqueia novas pastas de clientes que nao tenham regra explicita.
    match /clientes/{clientId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /conteudosInformativos/{module}/{itemId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImageOrPdf();
      allow delete: if signedIn();
    }

    match /eventos/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /noticias/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /configuracoes/paginaInicial/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /configuracoes/pagamento/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /configuracoes/combustiveis/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if signedIn() && request.auth.token.email == 'bruno.4and@gmail.com' && (request.resource == null || isNewImage());
    }

    match /beneficios/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isNewImage();
      allow delete: if signedIn();
    }

    match /gestao-terrenos/loteamentos/{developmentId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email == 'bruno.4and@gmail.com';
      allow create, update: if request.auth != null
        && request.auth.token.email == 'bruno.4and@gmail.com'
        && isNewImageOrPdf();
      allow delete: if request.auth != null && request.auth.token.email == 'bruno.4and@gmail.com';
    }

    match /gestao-terrenos/terrenos/{terrainId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email == 'bruno.4and@gmail.com';
      allow create, update: if request.auth != null
        && request.auth.token.email == 'bruno.4and@gmail.com'
        && isNewImage();
      allow delete: if request.auth != null && request.auth.token.email == 'bruno.4and@gmail.com';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
